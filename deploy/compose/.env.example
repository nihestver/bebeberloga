#
# Переменные для docker-compose.yml. Запусти ./init-env.sh — он создаст .env из этого файла
# и впишет случайные пароли. Файл .env хранится только на сервере: в git он не попадает.

# Домен инстанса. Для настоящего домена Caddy сам получает сертификат: нужны открытые порты
# 80 и 443 и запись DNS, указывающая на сервер напрямую. С localhost сертификат самоподписанный.
BB_DOMAIN=localhost

# Пароли хранилищ. Только латинские буквы и цифры: значения подставляются в адреса подключения.
# Менять после первого запуска нельзя — пароль уже записан в томе данных.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
NATS_PASSWORD=

# --- необязательное ---------------------------------------------------------

# Образ сервера. По умолчанию — последняя сборка main; для отката укажи тег-ревизию.
# BB_SERVER_IMAGE=ghcr.io/nihestver/bebeberloga/server:main

# Уровень журнала сервера: trace, debug, info, warn, error.
# BB_LOG_LEVEL=info

# Имя Compose-проекта (префикс контейнеров и томов), если на одном Docker несколько инстансов.
# COMPOSE_PROJECT_NAME=bebeberloga

# Лимиты памяти контейнеров. По умолчанию лимита нет. Лимит — потолок для одного сервиса:
# он не даёт сервису занять всю память сервера, но память не резервирует. Значения ниже —
# для сервера с 2 ГБ (в сумме 608 МБ); на таком сервере нужен и swap (deploy/README.md).
# BB_MEM_SERVER=128m
# BB_MEM_POSTGRES=256m
# BB_MEM_VALKEY=64m
# BB_MEM_NATS=96m
# BB_MEM_CADDY=64m
