# Входная точка инстанса: TLS и прокси на сервер Bebeberloga.
# BB_SITE_ADDRESS задаёт docker-compose.yml из BB_DOMAIN (.env): для домена вроде
# test.bebeberloga.org Caddy сам получает и продлевает сертификат (нужны открытые 80 и 443
# и запись DNS без прокси). Адрес вида `:80` (стенд агента, CI) — обычный HTTP без сертификата.
#
# Активной проверки upstream здесь нет намеренно: при одном сервере она ничего не балансирует,
# а ответ 503 от /api/v1/health подменила бы пустым 503 от Caddy — и стало бы не видно,
# какая зависимость недоступна.

# HTTP/3 выключен: API и gateway (WebSocket) работают по HTTP/1.1 и HTTP/2, а порт 443/udp
# наружу не открывается — docker-compose.yml публикует только 80 и 443/tcp.
{
	servers {
		protocols h1 h2
	}
}

{$BB_SITE_ADDRESS} {
	encode zstd gzip

	# REST API и gateway (WebSocket проксируется без отдельной настройки).
	# Пока сервер перезапускается, Caddy до 5 секунд повторяет попытку соединения.
	reverse_proxy server:8080 {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
