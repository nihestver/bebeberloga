{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(go *)",
      "Bash(cargo *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(buf *)",
      "Bash(hurl *)",
      "Bash(mise *)",
      "Bash(lefthook *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(git stash *)",
      "Bash(docker compose *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:book.openmls.tech)",
      "WebFetch(domain:docs.livekit.io)",
      "WebFetch(domain:www.rfc-editor.org)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:docs.pipewire.org)",
      "WebFetch(domain:code.claude.com)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(gh pr list *)",
      "Bash(reuse *)",
      "Bash(lychee *)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./deploy/**/.env)",
      "Read(./deploy/**/.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "WebFetch(domain:discord.com)",
      "WebFetch(domain:support.discord.com)",
      "WebFetch(domain:discord.dev)",
      "Read(./docs/PLAN.md)",
      "Bash(git show *PLAN.md*)",
      "Bash(git log *PLAN.md*)",
      "Bash(git diff *PLAN.md*)",
      "Bash(git blame *PLAN.md*)",
      "Bash(git grep *)",
      "Bash(git cat-file *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cleanroom-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'После сжатия контекста: перечитай CLAUDE.md и STATUS.md текущего модуля; изменённые файлы — git status.'"
          }
        ]
      }
    ]
  }
}
