  "description": "Bebeberloga: общий интерфейс web- и desktop-клиента",
  "license": "GPL-3.0-or-later WITH LicenseRef-Bebeberloga-AppStore-exception",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
